#!/usr/bin/env bash
# Pre-push: run Git LFS pre-push + clang-format (blocking) on project sources.
set -euo pipefail

# ---------------------------------------------------------------------------
# Git LFS — upload any new LFS objects before the push
# ---------------------------------------------------------------------------
if command -v git-lfs &>/dev/null; then
    git lfs pre-push "$@"
fi

# ---------------------------------------------------------------------------
# clang-format — blocks the push on any violation
# ---------------------------------------------------------------------------

# Only gate on clang-format-18 (the version pinned in CI / ubuntu-24.04
# default).  Other versions disagree on trailing-comment alignment so a
# generic `clang-format` check would either pass code that CI rejects or
# block code that CI accepts.  Skip with a clear hint when -18 isn't
# installed; CI is the authoritative gate.
if ! command -v clang-format-18 &>/dev/null; then
    echo "[pre-push] clang-format-18 not found — skipping format gate." >&2
    echo "           Install it (scripts/setup-linux.sh / setup-macos.sh) so" >&2
    echo "           local format gating matches CI." >&2
    exit 0
fi

CF_VER=$(clang-format-18 --version 2>&1 | head -1)
echo "[pre-push] Format check ($CF_VER) ..."

FORMAT_FAILED=0
while IFS= read -r f; do
    if ! clang-format-18 --dry-run --Werror "$f" 2>/dev/null; then
        echo "    ✗ $f" >&2
        FORMAT_FAILED=1
    fi
done < <(find src -type f \( -name "*.cpp" -o -name "*.hpp" -o -name "*.h" \) | sort)

if [ "$FORMAT_FAILED" -ne 0 ]; then
    printf '\n[pre-push] ✗ Unformatted files detected — push blocked.\n' >&2
    printf '  Auto-fix: cmake --build --preset debug --target format\n' >&2
    printf '  Then:     git add -u && git push\n\n' >&2
    exit 1
fi
echo "[pre-push] ✓ Format clean."
