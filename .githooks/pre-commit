#!/usr/bin/env bash
# Pre-commit: auto-format staged C++ files with the project-canonical clang-format.
# Runs at commit time; reformats and re-stages so the commit is always clean.
set -euo pipefail

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|hpp|h)$' || true)
if [ -z "$STAGED" ]; then
    exit 0
fi

# Auto-format ONLY when clang-format-18 is available — that's the version the
# CI format gate runs (ubuntu-24.04 default).  Other versions (e.g. clang-format
# trunk on Arch) format the same code differently for trailing-comment alignment
# and a few other knobs, so silently auto-formatting with a different version
# rewrites code into a layout the push gate rejects.
if ! command -v clang-format-18 &>/dev/null; then
    echo "[pre-commit] clang-format-18 not found — skipping auto-format." >&2
    echo "             Install it (scripts/setup-linux.sh / setup-macos.sh) so" >&2
    echo "             local formatting matches the CI format gate." >&2
    exit 0
fi

CF_VER=$(clang-format-18 --version 2>&1 | head -1)
echo "[pre-commit] clang-format ($CF_VER): formatting staged files..."

echo "$STAGED" | xargs clang-format-18 -i
echo "$STAGED" | xargs git add

echo "[pre-commit] Done."
