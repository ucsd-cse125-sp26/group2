{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/.deps"
      }
    },

    {
      "name": "base-clang",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER":   "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },

    {
      "name": "base-apple-clang",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER":   "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++"
      }
    },

    {
      "name": "base-msvc",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/msvc.cmake"
    },

    {
      "name": "debug",
      "displayName": "Debug (Linux — ASan + UBSan)",
      "inherits": "base-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_ASAN":      "ON",
        "ENABLE_UBSAN":     "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },

    {
      "name": "debug-mac",
      "displayName": "Debug (macOS — ASan + UBSan)",
      "inherits": "base-apple-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_ASAN":      "ON",
        "ENABLE_UBSAN":     "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },

    {
      "name": "debug-win",
      "displayName": "Debug (Windows — ASan via MSVC)",
      "inherits": "base-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_ASAN":      "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },

    {
      "name": "release",
      "displayName": "Release (Linux)",
      "inherits": "base-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },

    {
      "name": "release-mac",
      "displayName": "Release (macOS)",
      "inherits": "base-apple-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },

    {
      "name": "release-win",
      "displayName": "Release (Windows)",
      "inherits": "base-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },

    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo (Linux)",
      "inherits": "base-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },

    {
      "name": "relwithdebinfo-mac",
      "displayName": "RelWithDebInfo (macOS)",
      "inherits": "base-apple-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },

    {
      "name": "relwithdebinfo-win",
      "displayName": "RelWithDebInfo (Windows)",
      "inherits": "base-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],

  "buildPresets": [
    { "name": "debug",             "configurePreset": "debug" },
    { "name": "debug-mac",         "configurePreset": "debug-mac" },
    { "name": "debug-win",         "configurePreset": "debug-win" },
    { "name": "release",           "configurePreset": "release" },
    { "name": "release-mac",       "configurePreset": "release-mac" },
    { "name": "release-win",       "configurePreset": "release-win" },
    { "name": "relwithdebinfo",    "configurePreset": "relwithdebinfo" },
    { "name": "relwithdebinfo-mac","configurePreset": "relwithdebinfo-mac" },
    { "name": "relwithdebinfo-win","configurePreset": "relwithdebinfo-win" }
  ]
}
