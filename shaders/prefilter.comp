/// @file prefilter.comp
/// @brief Pre-filter the environment map for specular IBL (split-sum approximation).
///
/// Each mip level of the destination cubemap corresponds to one roughness value.
/// Mip 0 is a near-mirror sample of `envCubemap`; higher mips are GGX-importance-
/// sampled blurs of the same input cubemap.
///
/// The host binds **one face of one mip** as `outPrefilter` per dispatch (SDL_GPU
/// storage cube views are 2D, single-layer), so we run 6 dispatches per mip and
/// pass the cube face index in `face`.
///
/// Bindings (SDL3 GPU compute layout):
///   set=0,binding=0  samplerCube envCubemap   -- HDR environment cubemap (input)
///   set=1,binding=0  image2D     outPrefilter -- destination face slice
///   set=2,binding=0  PrefilterParams { float roughness; int face; }
///
/// Dispatch per face: (mipSize/16, mipSize/16, 1).
#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

/// @brief Source HDR environment cubemap.
layout(set = 0, binding = 0) uniform samplerCube envCubemap;

/// @brief Output pre-filtered specular face slice (one mip + one cube face).
layout(set = 1, binding = 0, rgba16f) writeonly uniform image2D outPrefilter;

/// @brief Per-mip / per-face parameters.
layout(set = 2, binding = 0) uniform PrefilterParams {
    float roughness; ///< 0 = mirror, 1 = fully rough.
    int face;        ///< Cube face index in [0,6).
    int _pad1, _pad2;
};

const float PI = 3.14159265359;

// Hammersley low-discrepancy sequence.
float radicalInverse_VdC(uint bits)
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 hammersley(uint i, uint N)
{
    return vec2(float(i) / float(N), radicalInverse_VdC(i));
}

/// @brief Sample a GGX half-vector in tangent space and rotate it to world space.
vec3 importanceSampleGGX(vec2 Xi, vec3 N, float a)
{
    float a2 = a * a;
    float phi = 2.0 * PI * Xi.x;
    float cosTheta = sqrt((1.0 - Xi.y) / (1.0 + (a2 - 1.0) * Xi.y));
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

    vec3 H = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);

    vec3 up = abs(N.z) < 0.999 ? vec3(0, 0, 1) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);

    return normalize(tangent * H.x + bitangent * H.y + N * H.z);
}

/// @brief Cubemap face index + UV in [-1,1] -> world-space direction.
vec3 cubeDir(int f, vec2 uv)
{
    switch (f) {
        case 0: return normalize(vec3( 1.0, -uv.y, -uv.x)); // +X
        case 1: return normalize(vec3(-1.0, -uv.y,  uv.x)); // -X
        case 2: return normalize(vec3( uv.x,  1.0,  uv.y)); // +Y
        case 3: return normalize(vec3( uv.x, -1.0, -uv.y)); // -Y
        case 4: return normalize(vec3( uv.x, -uv.y,  1.0)); // +Z
        case 5: return normalize(vec3(-uv.x, -uv.y, -1.0)); // -Z
    }
    return vec3(0.0);
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outPrefilter);

    if (coord.x >= size.x || coord.y >= size.y)
        return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(size) * 2.0 - 1.0;
    vec3 N = cubeDir(face, uv);
    vec3 R = N;
    vec3 V = R;

    // Mip 0 (roughness == 0): a single mirror sample of the environment.
    // Matches the analytical limit and avoids the 1-sample bias the GGX
    // importance loop produces at the boundary.
    if (roughness <= 0.0001) {
        vec3 c = textureLod(envCubemap, N, 0.0).rgb;
        imageStore(outPrefilter, coord, vec4(c, 1.0));
        return;
    }

    const uint SAMPLE_COUNT = 512u;
    vec3 prefilteredColor = vec3(0.0);
    float totalWeight = 0.0;

    for (uint i = 0u; i < SAMPLE_COUNT; ++i) {
        vec2 Xi = hammersley(i, SAMPLE_COUNT);
        vec3 H = importanceSampleGGX(Xi, N, roughness);
        vec3 L = normalize(2.0 * dot(V, H) * H - V);

        float NdotL = max(dot(N, L), 0.0);
        if (NdotL > 0.0) {
            // Reading from mip 0 of the source is fine for our 512px env;
            // could be replaced with a Krivanek mip-bias term if aliasing
            // becomes visible at very rough mip levels.
            prefilteredColor += textureLod(envCubemap, L, 0.0).rgb * NdotL;
            totalWeight += NdotL;
        }
    }

    prefilteredColor /= max(totalWeight, 0.001);
    imageStore(outPrefilter, coord, vec4(prefilteredColor, 1.0));
}
