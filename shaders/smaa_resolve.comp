/// @file smaa_resolve.comp
/// @brief SMAA temporal resolve for T2x/4x/8x.
/// Blends the current SMAA output with the reprojected history frame
/// using motion vectors.
#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

/// @brief Current SMAA output (smaaOutputTex).
layout(set = 0, binding = 0) uniform sampler2D currentFrame;
/// @brief Previous resolve result (taaHistory[src]).
layout(set = 0, binding = 1) uniform sampler2D historyFrame;
/// @brief Per-pixel RG16F motion vectors.
layout(set = 0, binding = 2) uniform sampler2D motionVectors;

/// @brief Resolved output image.
layout(set = 1, binding = 0, rgba16f) writeonly uniform image2D outputImage;

/// @brief Temporal resolve parameters.
layout(set = 2, binding = 0) uniform ResolveParams {
    vec2 screenSize;
    float blendFactor; // 0.5 default
    float _pad;
};

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(size);

    // Current frame color.
    vec3 current = texture(currentFrame, uv).rgb;

    // Motion vector for reprojection.
    vec2 motion = texture(motionVectors, uv).rg;
    vec2 reprojectedUV = uv - motion;

    // Reject history if reprojected UV is off-screen.
    if (reprojectedUV.x < 0.0 || reprojectedUV.x > 1.0 ||
        reprojectedUV.y < 0.0 || reprojectedUV.y > 1.0) {
        imageStore(outputImage, coord, vec4(current, 1.0));
        return;
    }

    // Sample history at reprojected position.
    vec3 history = texture(historyFrame, reprojectedUV).rgb;

    // Neighbourhood clamp: constrain history to the 3x3 min/max of the
    // current frame.  Prevents ghosting from stale history colours that
    // no longer exist in the scene (disocclusion, fast motion, lighting
    // changes).
    vec3 nMin = current, nMax = current;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            vec2 nUV = uv + vec2(float(dx), float(dy)) / screenSize;
            vec3 s = texture(currentFrame, nUV).rgb;
            nMin = min(nMin, s);
            nMax = max(nMax, s);
        }
    }
    history = clamp(history, nMin, nMax);

    // Velocity-based rejection: any per-pixel motion biases toward the
    // current frame to reduce ghosting during camera/object movement.
    float motionLen = length(motion);
    float velocityBlend = blendFactor;
    if (motionLen > 0.0005) {
        // Ramp blend factor towards 1.0 (fully current) for motion.
        // Reaches 1.0 at ~5 pixels of screen-space motion (0.0025 UV).
        velocityBlend = mix(blendFactor, 1.0, clamp((motionLen - 0.0005) * 400.0, 0.0, 1.0));
    }

    vec3 result = mix(history, current, velocityBlend);

    imageStore(outputImage, coord, vec4(result, 1.0));
}
