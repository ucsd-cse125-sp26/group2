/// @file irradiance.comp
/// @brief Convolve an HDR environment cubemap into a diffuse irradiance cubemap.
///
/// Each output texel stores the cosine-weighted integral of incoming radiance
/// over the hemisphere aligned with that texel's direction. Samples from the
/// input cubemap so any source -- procedural, HDR file, etc. -- works the same.
///
/// SDL_GPU storage cube views are 2D / single-layer, so the host binds **one
/// face slice** at a time and we run 6 dispatches. The face index is passed in
/// the UBO so the shader can compute the correct world-space direction.
///
/// Bindings (SDL3 GPU compute layout):
///   set=0,binding=0  samplerCube envCubemap     -- HDR environment cubemap (input)
///   set=1,binding=0  image2D     outIrradiance  -- destination face slice
///   set=2,binding=0  IrradianceParams { int face; }
///
/// Dispatch per face: (faceSize/16, faceSize/16, 1).
#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

/// @brief Source HDR environment cubemap.
layout(set = 0, binding = 0) uniform samplerCube envCubemap;

/// @brief Output diffuse irradiance face slice.
layout(set = 1, binding = 0, rgba16f) writeonly uniform image2D outIrradiance;

/// @brief Per-face parameter (only the face index varies between dispatches).
layout(set = 2, binding = 0) uniform IrradianceParams {
    int face;
    int _pad1, _pad2, _pad3;
};

const float PI = 3.14159265359;

/// @brief Convert cubemap face + UV in [-1,1] to a world-space direction.
vec3 cubeDir(int f, vec2 uv)
{
    switch (f) {
        case 0: return normalize(vec3( 1.0, -uv.y, -uv.x)); // +X
        case 1: return normalize(vec3(-1.0, -uv.y,  uv.x)); // -X
        case 2: return normalize(vec3( uv.x,  1.0,  uv.y)); // +Y
        case 3: return normalize(vec3( uv.x, -1.0, -uv.y)); // -Y
        case 4: return normalize(vec3( uv.x, -uv.y,  1.0)); // +Z
        case 5: return normalize(vec3(-uv.x, -uv.y, -1.0)); // -Z
    }
    return vec3(0.0);
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outIrradiance);

    if (coord.x >= size.x || coord.y >= size.y)
        return;

    // Direction for this texel.
    vec2 uv = (vec2(coord) + 0.5) / vec2(size) * 2.0 - 1.0;
    vec3 N = cubeDir(face, uv);

    // Build a tangent frame around N.
    vec3 up = abs(N.y) < 0.999 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 right = normalize(cross(up, N));
    up = cross(N, right);

    // Riemann-sum integration over the hemisphere.
    vec3 irradiance = vec3(0.0);
    float sampleCount = 0.0;
    const float deltaPhi = 0.025;
    const float deltaTheta = 0.025;

    for (float phi = 0.0; phi < 2.0 * PI; phi += deltaPhi) {
        for (float theta = 0.0; theta < 0.5 * PI; theta += deltaTheta) {
            // Spherical to cartesian (tangent space).
            vec3 tangentSample = vec3(sin(theta) * cos(phi),
                                      sin(theta) * sin(phi),
                                      cos(theta));
            // Tangent space -> world.
            vec3 sampleVec = tangentSample.x * right +
                             tangentSample.y * up +
                             tangentSample.z * N;

            irradiance += textureLod(envCubemap, sampleVec, 0.0).rgb * cos(theta) * sin(theta);
            sampleCount += 1.0;
        }
    }

    irradiance = PI * irradiance / sampleCount;
    imageStore(outIrradiance, coord, vec4(irradiance, 1.0));
}
